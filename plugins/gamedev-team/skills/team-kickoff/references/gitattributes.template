# Normalize line endings for text
* text=auto

# Unity YAML: text, LF, Smart Merge when configured (falls back to normal merge otherwise)
*.unity      text eol=lf merge=unityyamlmerge linguist-generated lockable
*.prefab     text eol=lf merge=unityyamlmerge linguist-generated
*.asset      text eol=lf merge=unityyamlmerge linguist-generated
*.mat        text eol=lf merge=unityyamlmerge linguist-generated
*.anim       text eol=lf merge=unityyamlmerge linguist-generated
*.controller text eol=lf merge=unityyamlmerge linguist-generated
*.physicMaterial text eol=lf merge=unityyamlmerge linguist-generated
*.meta       text eol=lf
*.cs         text diff=csharp
*.md         text

# Art sources: LFS + lockable (one person edits at a time)
*.blend  filter=lfs diff=lfs merge=lfs -text lockable
*.psd    filter=lfs diff=lfs merge=lfs -text lockable
*.kra    filter=lfs diff=lfs merge=lfs -text lockable
*.spp    filter=lfs diff=lfs merge=lfs -text lockable
*.aseprite filter=lfs diff=lfs merge=lfs -text lockable

# Imported binaries: LFS
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.obj  filter=lfs diff=lfs merge=lfs -text
*.glb  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.aif  filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text
